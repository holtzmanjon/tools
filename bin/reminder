#!/usr/bin/env python

import subprocess
import argparse
import tempfile
import pdb
from holtztools import reminder
from astropy.table import Table

if __name__ == '__main__' :

    parser=argparse.ArgumentParser()
    parser.add_argument('--ndays',type=int,help="Look for spreadsheet lines with date < ndays")
    parser.add_argument('--broadcast',help="send email to this broadcast address")
    parser.add_argument('--header',default='My reminder: \n',help="text of email before spreadsheet lines")
    parser.add_argument('--subject',default='Reminder',help="subject for email")
    parser.add_argument('--datecol',default='Date',help="spreadsheet column header for column with date")
    parser.add_argument('--emailcol',default='Email',help="spreadsheet column for emails to specific individuals")
    parser.add_argument('--messagecols',nargs='*',default=['Date','Responsible party'],help="spreadsheet columns to include in email")
    parser.add_argument('--messagefmt',nargs='*',default=['{:s}','{:s}'],help="format for spreadsheet columns to include in email")
    parser.add_argument('--addr',default='https://docs.google.com/spreadsheets/d/10XUbViGVJvek49jQ7xD_HOcFLJYxPkCvgL2VAFeCvFE',
                       help="Google sheet address")
    parser.add_argument('--individual',action='store_true',help="send email to the addresses in specified email column")
    args = parser.parse_args()

    # download the current version of google sheet
    tab=reminder.get(args.addr+'/export?format=tsv')
    addr=args.addr+'/edit?gid=141225421#gid=141225421'
    reminder.newsend(tab,ndays=args.ndays,datecol=args.datecol,messagecols=args.messagecols,messagefmt=args.messagefmt,
                     emailcol=args.emailcol,individual=args.individual,subject=args.subject,header=args.header,broadcast=args.broadcast,
                     addr=addr)

    #with tempfile.NamedTemporaryFile(mode='w+', delete=True) as temp_file:
    #    print(f"Temporary file created at: {temp_file.name}")
    #    fp=open(temp_file.name,'w')
    #    output=subprocess.run(['curl','-L',addr],stdout=fp)
    #    fp.seek(0)
    #    tab=Table.read(temp_file.name,format='ascii.tab')
#        print(tab)
#
    #reminder.send('astroph',args.ndays,header=args.header,
    #         broadcast=args.broadcast,individual=args.individual)

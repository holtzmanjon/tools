#!/Users/holtz/anaconda3/envs/pyvista/bin/python

import subprocess
import argparse
import tempfile
import pdb
from holtztools import reminder
from astropy.table import Table

if __name__ == '__main__' :

    parser=argparse.ArgumentParser()
    parser.add_argument('--ndays',type=int)
    parser.add_argument('--broadcast',default='holtz')
    parser.add_argument('--header',default='Observing schedule for this week: \n')
    parser.add_argument('--subject',default='SONG observing reminder')
    parser.add_argument('--datecol',default='Start date')
    parser.add_argument('--emailcol',default='Email')
    parser.add_argument('--messagecols',default=['Start date','Responsible party'])
    parser.add_argument('--messagefmt',nargs='*',default=['{:s}','{:s}'])
    parser.add_argument('--individual',action='store_true')
    args = parser.parse_args()

    # download the current version of google sheet
    addr='https://docs.google.com/spreadsheets/d/10XUbViGVJvek49jQ7xD_HOcFLJYxPkCvgL2VAFeCvFE/export?format=tsv'
    tab=reminder.get(addr)
    reminder.newsend(tab,ndays=args.ndays,datecol=args.datecol,messagecols=args.messagecols,messagefmt=args.messagefmt,
                     emailcol=args.emailcol,individual=args.individual,subject=args.subject,header=args.header,broadcast=args.broadcast)

    #with tempfile.NamedTemporaryFile(mode='w+', delete=True) as temp_file:
